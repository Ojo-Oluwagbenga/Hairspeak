CREATE A GIT REPO

INITIALIZE GIT IN PROJECT

git init
git checkout -b main  # This will first set the branch that all add and commits are going.
git branch -M main


REMOVE THE SETTINGS FILE FROM THE GITIGNORE
Create the .gitignore file and include the settings, and asgi

git rm -r --cached .


COMMIT TO THE MAIN

git add .; git commit -m "General Commit"; git push -u origin main

OPEN THE CLOUD

CREATE HAIRSPEAK DB

sudo -u postgres psql
CREATE DATABASE hairspeak;
CREATE USER hairspeak_user WITH PASSWORD '12345';
ALTER ROLE hairspeak_user SET client_encoding TO 'utf8';
ALTER ROLE hairspeak_user SET default_transaction_isolation TO 'read committed';
ALTER ROLE hairspeak_user SET timezone TO 'UTC';
GRANT ALL PRIVILEGES ON DATABASE hairspeak TO hairspeak_user;
\q

CREATE THE FOLDER FOR HAIRSPEAK
mkdir projects/hairspeak
cd projects/hairspeak
git init
git remote add origin https://github.com/Ojo-Oluwagbenga/Hairspeak.git
git pull origin the_branch --allow-unrelated-histories  # or
git pull -f origin main

cd hairspeak/hairspeak
sudo nano settings.py


Add the following inside:

import os
# __all settings data
CSRF_TRUSTED_ORIGINS = ["projame.com"]
ALLOWED_HOSTS = ["https://projame.com"]
STATIC_ROOT = os.path.join(BASE_DIR, 'static/')


Save and exit: ctrl + x, y, enter

Then edit asgi.py:

sudo nano asgi.py


Add:

# __all asgi data

ACTIVATE THE ENVIRONMENT TO FINISH DB SETTINGS
cd
source projects/oneklassenv/bin/activate
cd projects/hairspeak
python manage.py makemigrations
python manage.py migrate
python manage.py collectstatic
python manage.py createsuperuser  # if you will

SET UP GUNICORN SOCKET AND SERVICE

Create socket file:

sudo nano /etc/systemd/system/hairspeak.socket

[Unit]
Description=hairspeak socket

[Socket]
ListenStream=/run/hairspeak.sock

[Install]
WantedBy=sockets.target


Save and exit.

SET UP THE SERVICE
sudo nano /etc/systemd/system/hairspeak.service

[Unit]
Description=hairspeak daemon
Requires=hairspeak.socket
After=network.target

[Service]
User=rider
Group=www-data
WorkingDirectory=/home/rider/projects/hairspeak
ExecStart=/home/rider/projects/oneklassenv/bin/gunicorn \
          --access-logfile - \
          -k uvicorn.workers.UvicornWorker \
          --workers 3 \
          --bind unix:/run/hairspeak.sock \
          hairspeak.asgi:application

[Install]
WantedBy=multi-user.target

START THE SERVICES
sudo systemctl start hairspeak.socket
sudo systemctl enable hairspeak.socket
sudo systemctl status hairspeak.socket
sudo journalctl -u hairspeak.socket
sudo systemctl status hairspeak

sudo systemctl daemon-reload
sudo systemctl restart hairspeak

CONNECT THE DOMAIN NAME
sudo nano /etc/nginx/sites-available/server_domain_or_IP  # e.g. hairspeak.com.ng

server {
    listen 80;
    server_name server_domain_or_IP; # e.g. hairspeak.com.ng

    location = /favicon.ico { access_log off; log_not_found off; }
    location /static/ {
        root /home/rider/projects/hairspeak;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/hairspeak.sock;
    }
}


LINK THE SITE

sudo ln -s /etc/nginx/sites-available/server_domain_or_IP /etc/nginx/sites-enabled
sudo nginx -t
sudo systemctl restart nginx

GET A CERTIFICATE
sudo apt remove certbot
sudo snap install --classic certbot
sudo ln -s /snap/bin/certbot /usr/bin/certbot
sudo certbot --nginx -d server_domain_or_IP

SET UP AUTO DEPLOY MECHANISM
cd
sudo nano serve_hairspeak.sh

#!/bin/bash
# Exit if any command fails
set -e
echo "Starting deployment..."
# Navigate to the project directory
cd ~/projects/hairspeak || exit
# Reset and pull latest changes from Git
sudo git reset --hard
sudo git pull -f origin main
# Activate the virtual environment
source ~/projects/oneklassenv/bin/activate
# Collect static files
python manage.py collectstatic --noinput
# Deactivate virtual environment
deactivate
# Reload systemd and restart services
sudo systemctl daemon-reload
sudo systemctl restart hairspeak
sudo systemctl restart nginx

echo "✅ Successfully Deployed and Restarted"


Save and exit.

MAKE IT EXECUTABLE ON SIMPLE COMMAND

sudo chmod +x serve_hairspeak.sh
./serve_hairspeak.sh


✅ DONE

